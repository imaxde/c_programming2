digraph NumberAutomaton {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    edge [fontname="Helvetica"];

    start [shape=none, label=""];
    1, 3, 6 [shape=doublecircle];

    start -> 0;
    0 -> 1 [label="цифра"];
    1 -> 1 [label="цифра"];
    1 -> 2 [label=".", fontsize=24];
    2 -> 3 [label="цифра"];
    3 -> 3 [label="цифра"];
    1 -> 4 [label="E"];
    3 -> 4 [label="E"];
    4 -> 5 [label="+, -"];
    4 -> 6 [label="цифра"];
    5 -> 6 [label="цифра"];
    6 -> 6 [label="цифра"];
}
